# Copy this file to .env.local and fill in the real values. NEVER commit .env.local.
# Everything below is a dummy example. Required settings are marked REQUIRED.

# --- Database (Supabase) --------------------------------------------------
# REQUIRED. Supabase: Project Settings > Database > Connection string (session pooler).
DATABASE_URL=postgresql://user:password@host:5432/postgres

# --- Crete data store (Facebook, Instagram, TikTok posts) -----------------
# REQUIRED for the Crete sync. Both come from Sapio. The key only needs read access.
ES_URL=https://xxxxxxxx.europe-west3.gcp.cloud.es.io
ES_API_KEY=replace-me
# Safety limit: stop a run if it reads more than this many posts for one platform. Optional (default 50000).
CRETE_MAX_POSTS=50000

# --- Meta Ad Library (ads tracking) ---------------------------------------
# REQUIRED for the ads sync. A long-lived token from Meta's Graph API Explorer. Expires about every 60 days.
META_ACCESS_TOKEN=replace-me
# Safety limit on pages fetched per Meta search (250 ads a page). Optional (default 60).
META_MAX_PAGES=60

# --- Sign-in (Project Beacon) ---------------------------------------------
# Set BEACON_AUTH=on online to require a Project Beacon sign-in. Leave unset on your own computer.
BEACON_AUTH=
BEACON_SITE_URL=https://dashboard.project-beacon.co.uk
BEACON_SIGNIN_URL=https://project-beacon.co.uk/signin
BEACON_API_URL=https://api.project-beacon.co.uk
# Older shared-password gate. Optional; ignored when empty.
SITE_USERNAME=
SITE_PASSWORD=

# --- Scheduled syncs and links --------------------------------------------
# A long random string. Protects the /api/cron/sync address from outsiders.
CRON_SECRET=replace-me
# The public address of the site, used in links inside approval emails.
APP_BASE_URL=http://localhost:3000

# --- Approval emails (optional) -------------------------------------------
# Comma-separated addresses that get an email when a Facebook Group post count or
# subscriber count needs approving. Without the two Gmail settings, no email is sent
# and approvals are done from the Admin page instead.
APPROVAL_EMAILS=someone@example.com
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=

# --- Display ---------------------------------------------------------------
# First Monday shown on Rankings (YYYY-MM-DD). Optional (default 2026-10-05).
TRACKING_START=2026-10-05
