{
  "name": "digital-performance-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "sync:crete": "tsx --env-file=.env.local scripts/sync_crete.mts",
    "sync:crete:dry": "tsx --env-file=.env.local scripts/sync_crete.mts --dry-run",
    "sync:meta": "tsx --env-file=.env.local scripts/sync_meta_ads.mts",
    "sync:meta:dry": "tsx --env-file=.env.local scripts/sync_meta_ads.mts --dry-run",
    "check:crete": "tsx --env-file=.env.local scripts/check_crete_coverage.mts",
    "test:growth": "tsx scripts/test_subscriber_growth.mts",
    "typecheck": "tsc --noEmit",
    "test:amplifiers": "tsx scripts/test_amplifier_scoring.mts",
    "notify:pending": "tsx --env-file=.env.local scripts/notify_pending_approvals.mts",
    "notify:pending:dry": "tsx --env-file=.env.local scripts/notify_pending_approvals.mts --dry-run",
    "test:digest": "tsx scripts/test_pending_digest.mts",
    "meta:renew": "tsx --env-file=.env.local scripts/renew_meta_token.mts",
    "meta:renew:dry": "tsx --env-file=.env.local scripts/renew_meta_token.mts --dry-run",
    "test:reels": "tsx scripts/test_reel_detection.mts"
  },
  "dependencies": {
    "csv-parse": "^7.0.2",
    "next": "16.3.1",
    "nodemailer": "^9.0.5",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
